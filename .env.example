# Arquibancada UCL HNK 2027
# Copie para .env.local (local) ou cadastre na Vercel (Settings > Environment Variables).
# Nunca commite valores reais: .env* esta no .gitignore.

# ---------------------------------------------------------------------------
# Publico (vai para o navegador). Nada sensivel aqui.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3033
NEXT_PUBLIC_CLUBE_HEINEKEN_URL=https://clube.heineken.com.br/

# ---------------------------------------------------------------------------
# Segredos do servidor (nunca use prefixo NEXT_PUBLIC_ nestas chaves)
# Gere cada um com: openssl rand -base64 48
# ---------------------------------------------------------------------------
# Assina URLs de midia e protege /api/internal/*. Obrigatorio em producao (>= 32 caracteres).
INTERNAL_SIGNING_SECRET=

# Header x-internal-secret enviado ao n8n. O MESMO valor vai na credencial
# "Header Auth" do Webhook no n8n Cloud. Sem ele, o app pula o n8n.
N8N_WEBHOOK_SECRET=

# Bearer aceito por /api/internal/cleanup (Vercel Cron envia automaticamente).
CRON_SECRET=

# ---------------------------------------------------------------------------
# Pipeline de IA. Recomendado: so o n8n, com a chave do Gemini guardada LA.
# ---------------------------------------------------------------------------
N8N_CLOUD_WEBHOOK_URL=https://viniciusouza.app.n8n.cloud/webhook/arquibancada-ucl2027

# Opcional: n8n local em modo callback (npm run n8n:auto)
N8N_WEBHOOK_URL=

# Opcional (modo B, sem n8n): chamada direta ao Gemini a partir do servidor.
# Deixe vazio quando usar o n8n: assim a chave existe em um lugar so.
GEMINI_API_KEY=
NANO_BANANA_MODEL=gemini-nano-banana-2.1
AI_TIMEOUT_MS=90000

# Chave da API do n8n, usada apenas por scripts/deploy-n8n-cloud.mjs na sua maquina.
N8N_API_KEY=

# ---------------------------------------------------------------------------
# Armazenamento e limites
# ---------------------------------------------------------------------------
# Vercel Blob (fase Vercel). Vazio = disco local em .data/ (so desenvolvimento).
BLOB_READ_WRITE_TOKEN=
# Copia local de selfies e resultados (so na sua maquina; ignorado na Vercel).
DRIVE_OUTPUT_DIR=

MAX_GENERATIONS_PER_DEVICE_PER_DAY=5
MAX_GLOBAL_GENERATIONS_PER_DAY=500
BYPASS_RATE_LIMIT_LOCAL=false
