# Ambiente Local / Vercel - Webapp Arquibancada UCL HNK 2027

# URL publica da aplicacao (usada para metadados OpenGraph e links compartilhados)
NEXT_PUBLIC_APP_URL=http://localhost:3033

# URL de cadastro do Clube Heineken (trocavel por configuracao sem deploy)
NEXT_PUBLIC_CLUBE_HEINEKEN_URL=https://clube.heineken.com.br/

# Integracao n8n (Cloud sync primeiro, depois fallback local/direto)
N8N_CLOUD_WEBHOOK_URL=
N8N_WEBHOOK_URL=
# Chave da API do n8n Cloud usada apenas por scripts/deploy-n8n-cloud.mjs
N8N_API_KEY=

# Integracao direta Gemini Nano Banana 2.1 (opcional: usada se N8N_WEBHOOK_URL estiver vazio)
GEMINI_API_KEY=
NANO_BANANA_MODEL=gemini-nano-banana-2.1
AI_TIMEOUT_MS=90000

# Segredo compartilhado entre Next.js (Vercel) e n8n (header x-internal-secret + assinatura de midia)
INTERNAL_SIGNING_SECRET=dev-secret-trocar-em-producao-hnk-ucl-2027

# Pasta local/Drive onde o n8n salva selfies e resultados gerados (opcional)
DRIVE_OUTPUT_DIR=

# Vercel Blob (opcional em producao: se vazio, usa armazenamento privado local em .data/storage)
BLOB_READ_WRITE_TOKEN=

# Limites diarios de uso (ajuste ou defina BYPASS_RATE_LIMIT_LOCAL=true apenas para testes de bancada)
MAX_GENERATIONS_PER_DEVICE_PER_DAY=5
MAX_GLOBAL_GENERATIONS_PER_DAY=500
BYPASS_RATE_LIMIT_LOCAL=false
