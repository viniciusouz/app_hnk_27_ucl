      "parameters": {
        "jsCode": "const base = $('Montar Payload Nano Banana 2.1').first().json;\nconst durationMs = Date.now() - Number(base.startedAt || Date.now());\nconst candidate = $json?.candidates?.[0];\nconst finishReason = candidate?.finishReason || '';\nconst parts = candidate?.content?.parts || [];\nlet foundData = null;\nfor (const p of parts) {\n  const inline = p?.inlineData || p?.inline_data;\n  if (inline?.data) {\n    foundData = inline.data;\n    break;\n  }\n}\n\nconst isSafetyRefusal = ['SAFETY', 'IMAGE_SAFETY', 'PROHIBITED_CONTENT', 'RECITATION'].includes(finishReason);\n\nreturn [\n  {\n    json: {\n      jobId: base.jobId,\n      names: base.names,\n      composeUrl: base.composeUrl,\n      jobPatchUrl: base.jobPatchUrl,\n      durationMs,\n      finishReason,\n      validImage: Boolean(foundData) && !isSafetyRefusal,\n      composedImageBase64: foundData\n    }\n  }\n];"
      },
